# Default: normalize text to LF in the repo
* text=auto eol=lf

# --- Committed SQLite (plain git, no LFS): per-language packs + neutral enrichment DB ---
# binary = -diff -merge -text (no eol munging, no textual diff); stays in normal git.
# (The public repo carries no Git LFS objects; the private build inputs that were
#  formerly LFS-tracked are no longer distributed.)
enrichment/lang/*.sqlite          binary
dist/core-enrichment.sqlite       binary

# --- Visual Studio project files keep CRLF (MSVC convention) ---
*.sln               text eol=crlf
*.vcxproj           text eol=crlf
*.vcxproj.filters   text eol=crlf
*.props             text eol=crlf

# --- Shell scripts must stay LF ---
*.sh                text eol=lf

# --- Treat common binaries as binary ---
*.dll  binary
*.exe  binary
*.pdb  binary
*.png  binary
