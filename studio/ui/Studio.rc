// SPDX-License-Identifier: GPL-3.0-or-later
// Studio's own chrome only. The translated MPC-HC dialogs/menus come from the neutral
// resource DLL at runtime — never from this file.
#include "resource.h"
#include "afxres.h"

// App icon (issue #4): MPC-HC clapperboard + translation badge, composed from upstream's GPL
// res/icon.ico by scratch tooling; sizes 256/48/32/24/16.
IDI_STUDIO ICON "res\\studio.ico"

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Submit &PR...",                       ID_FILE_SUBMITPR
        MENUITEM SEPARATOR
        MENUITEM "Render dialogs from &RC (Approach C)...", ID_FILE_RENDERRC
        MENUITEM "Render from &bundle DLL",             ID_FILE_RENDERBUNDLE
        MENUITEM SEPARATOR
        MENUITEM "AI &provider...",                     ID_FILE_AI_PROVIDER
        MENUITEM "Transifex &token...",                 ID_FILE_TX_TOKEN
        MENUITEM "Generate AI &suggestions...",         ID_FILE_GENERATE_AI
        MENUITEM "Generate AI suggestions for &ALL languages...", ID_FILE_GENERATE_AI_ALL
        MENUITEM "Export AI-prep &context for this string...",       ID_FILE_EXPORT_AI_CTX
        MENUITEM "Export AI-prep context for current &language...",  ID_FILE_EXPORT_AI_CTX_LANG
        MENUITEM SEPARATOR
        MENUITEM "Check for &data updates...",          ID_FILE_CHECK_DATA_UPDATE
        MENUITEM "&Transifex sync...",                  ID_FILE_TXSYNC
        MENUITEM "Propose Transifex sync &PR...",       ID_FILE_TXSYNC_PR
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                               ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        POPUP "&Theme"
        BEGIN
            MENUITEM "MPC-HC &Dark",                     ID_VIEW_THEME_DARK
            MENUITEM "MPC-HC &Light",                    ID_VIEW_THEME_LIGHT
            MENUITEM "&Follow Windows",                  ID_VIEW_THEME_SYSTEM
        END
    END
END

1 RT_MANIFEST "Studio.exe.manifest"

/////////////////////////////////////////////////////////////////////////////
// "Suggest a correction" modal (SuggestFixDlg.cpp). No RC controls — the template just gives
// CDialog a window + default font; every control is created programmatically in OnInitDialog
// (SuggestFixDlg sizes/positions itself in code too, so this placeholder size doesn't matter).

IDD_SUGGEST_FIX DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Suggest a correction"
FONT 9, "Segoe UI"
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// "AI provider…" modal (AiSettingsDlg.cpp). No RC controls — same empty-template, code-driven
// style as IDD_SUGGEST_FIX / SuggestFixDlg.

IDD_AI_SETTINGS DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "AI provider"
FONT 9, "Segoe UI"
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// "Transifex sync…" modal (TxSyncDlg.cpp). No RC controls — same empty-template, code-driven
// style as IDD_SUGGEST_FIX / IDD_AI_SETTINGS.

IDD_TXSYNC DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Transifex sync"
FONT 9, "Segoe UI"
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// "Transifex token…" modal (TxTokenDlg.cpp). No RC controls — same empty-template, code-driven
// style as IDD_SUGGEST_FIX / IDD_AI_SETTINGS / IDD_TXSYNC.

IDD_TXTOKEN DIALOGEX 0, 0, 300, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Transifex token"
FONT 9, "Segoe UI"
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
