IDB_DT_CB_96             PNG                     "res\\darktheme\\checkboxes-96.png"
IDB_DT_CB_120            PNG                     "res\\darktheme\\checkboxes-120.png"
IDB_DT_CB_144            PNG                     "res\\darktheme\\checkboxes-144.png"
IDB_DT_CB_192            PNG                     "res\\darktheme\\checkboxes-192.png"
IDB_DT_RADIO_96          PNG                     "res\\darktheme\\radios-96.png"
IDB_DT_RADIO_120         PNG                     "res\\darktheme\\radios-120.png"
IDB_DT_RADIO_144         PNG                     "res\\darktheme\\radios-144.png"
IDB_DT_RADIO_192         PNG                     "res\\darktheme\\radios-192.png"
